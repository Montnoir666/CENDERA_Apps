# Copy to .env and fill in for local use; on a host (Render/Railway/etc.)
# set these as real environment variables instead.

# Random long string — required before any real/remote deployment.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-insecure-secret-change-me

# Google Maps JavaScript API key (must have billing enabled on its project).
GOOGLE_MAPS_API_KEY=AIzaSyCqqXYgttY-VrgIEiJykkYTV97m9q1UO2A

# Port the Flask app listens on.
PORT=5000

# Logins now live in accounts/users.xlsx (not here) — see app/auth.py and
# scripts/setup_accounts.py.

# Only needed to run scripts/sync_accounts_to_render.py (pushes
# accounts/users.xlsx to Render's live Secret File so you don't have to
# copy-paste it into the dashboard by hand). Not read by the app itself.
#   RENDER_API_KEY:    Render dashboard -> Account Settings -> API Keys -> Create API Key
#   RENDER_SERVICE_ID: the "srv-..." id in the service's dashboard URL,
#                       e.g. dashboard.render.com/web/srv-XXXXXXXXXXXXXXXXXXXX
RENDER_API_KEY=
RENDER_SERVICE_ID=
