# Copy to .env and fill in for local use; on a host (Render/Railway/etc.)
# set these as real environment variables instead.

# Random long string — required before any real/remote deployment.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-insecure-secret-change-me

# Google Maps JavaScript API key (must have billing enabled on its project).
GOOGLE_MAPS_API_KEY=AIzaSyCqqXYgttY-VrgIEiJykkYTV97m9q1UO2A

# Port the Flask app listens on.
PORT=5000

